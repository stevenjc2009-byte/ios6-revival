			<string>SizeMB</string>
			<key>default</key>
			<string>90</string>
			<key>keyboard</key>
			<string>numbers</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>Days until deletion</string>
			<key>defaults</key>
			<string>com.stevenjc.ios6revival.logwatch</string>
			<key>key</key>
			<string>Days</string>
			<key>default</key>
			<string>2</string>
			<key>keyboard</key>
			<string>numbers</string>
		</dict>
	</array>
