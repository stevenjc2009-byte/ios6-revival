#!/usr/bin/python3
"""mail-authorise -- sign the bridge in to Gmail / Outlook (runs inside the container, as root).

    pct enter <VMID>
    mail-authorise              authorise every account in /etc/mailproxy/emailproxy.config
    mail-authorise ACCOUNT ...  only those accounts
    mail-authorise --reset ...  forget the stored tokens of those accounts (or all), then authorise

What happens: you type the PHONE PASSWORD (the one you will put in iOS Mail; it is not your Google
or Microsoft password, it is never stored, it only encrypts the stored OAuth tokens). The mailproxy
service is stopped, the proxy is started here in the foreground in external-auth mode, and this script
logs in to it once per account. The proxy prints a Google/Microsoft URL: open it in YOUR OWN browser,
sign in, and paste the final address-bar URL (it starts with http://localhost and the page will fail
to load -- that is expected) back here. Then the service is started again.
"""
import configparser
import getpass
import imaplib
import os
import pwd
import socket
import subprocess
import sys
import time

CONFIG = "/etc/mailproxy/emailproxy.config"
CACHE = "/var/lib/mailproxy/tokens.cache"
PROXY = "/opt/mailproxy/emailproxy.py"
SERVICE = "mailproxy.service"
# permission_url host of an account -> the upstream IMAP host whose local listener handles it
PROVIDERS = {"accounts.google.com": "imap.gmail.com", "login.microsoftonline.com": "outlook.office365.com"}


def die(msg):
    print("mail-authorise: " + msg, file=sys.stderr)
    sys.exit(1)


def read_config():
    cp = configparser.ConfigParser(interpolation=None)
    if not cp.read(CONFIG):
        die("cannot read " + CONFIG)
    ports = {}  # upstream IMAP host -> local port
    for sec in cp.sections():
        if sec.startswith("IMAP-"):
            ports[cp.get(sec, "server_address")] = int(sec.split("-", 1)[1])
    accounts = {}  # account -> local IMAP port
    for sec in cp.sections():
        if "@" in sec and not sec.startswith("@"):
            host = cp.get(sec, "permission_url", fallback="").split("/")[2:3]
            upstream = PROVIDERS.get(host[0]) if host else None
            if upstream in ports:
                accounts[sec] = ports[upstream]
    return accounts


def ask_password():
    print("Choose the PHONE PASSWORD for the bridge (not your Google/Microsoft password).")
    print("It encrypts the stored tokens and is typed once into iOS Mail. 10+ characters; no \" or \\.")
    while True:
        pw = getpass.getpass("Phone password: ")
        if len(pw) < 10 or '"' in pw or "\\" in pw or not pw.isprintable():
            print("  too short (10+), or contains \" or \\, or a non-printable character.")
            continue
        if getpass.getpass("Again: ") != pw:
            print("  they differ.")
            continue
        return pw


def reset_tokens(names):
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(CACHE)
    for sec in list(cp.sections()):
        if not names or sec in names:
            cp.remove_section(sec)
            print("  forgot stored tokens of " + sec)
    old = os.umask(0o077)
    with open(CACHE, "w", encoding="utf-8") as fh:
        cp.write(fh)
    os.umask(old)
    pw = pwd.getpwnam("mailproxy")
    os.chown(CACHE, pw.pw_uid, pw.pw_gid)


def wait_listen(port, proc):
    for _ in range(40):
        if proc.poll() is not None:
            die("the proxy exited early (see its output above)")
        try:
            socket.create_connection(("127.0.0.1", port), 1).close()
            return
        except OSError:
            time.sleep(0.5)
    die("proxy did not start listening on 127.0.0.1:%d" % port)


def main():
    args = sys.argv[1:]
    reset = "--reset" in args
    names = [a for a in args if not a.startswith("--")]
    if os.geteuid() != 0:
        die("run as root inside the container (pct enter <VMID>)")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die("needs a terminal; use `pct enter <VMID>`, not `pct exec`")
    accounts = read_config()
    for n in names:
        if n not in accounts:
            die("%s is not an account in %s (known: %s)" % (n, CONFIG, ", ".join(accounts) or "none"))
    todo = [a for a in accounts if not names or a in names]
    if not todo:
        die("no accounts configured in " + CONFIG)
    password = ask_password()
    print("Stopping %s while you authorise ..." % SERVICE)
    subprocess.run(["systemctl", "stop", SERVICE], check=False)
    if reset:
        reset_tokens(names)
    pw = pwd.getpwnam("mailproxy")

    def drop():
        os.setgroups([])
        os.setgid(pw.pw_gid)
        os.setuid(pw.pw_uid)
        os.umask(0o077)

    proc = subprocess.Popen(
        ["/usr/bin/python3", "-I", "-B", PROXY, "--no-gui", "--external-auth",
         "--config-file", CONFIG, "--cache-store", CACHE],
        preexec_fn=drop, env={"PATH": "/usr/bin:/bin", "HOME": "/nonexistent", "TERM": os.environ.get("TERM", "xterm")})
    failed = []
    try:
        wait_listen(next(iter(accounts.values())), proc)
        for acct in todo:
            print("\n=== %s ===\nThe proxy will now print a URL. Open it in your own browser, sign in, then paste"
                  " the final http://localhost... address back at its prompt." % acct)
            try:
                conn = imaplib.IMAP4("127.0.0.1", accounts[acct], timeout=660)
                conn.login(acct, password)
                conn.logout()
                print("\n[OK] %s signed in and the token is stored (encrypted with your phone password)." % acct)
            except (imaplib.IMAP4.error, OSError) as exc:
                failed.append(acct)
                print("\n[FAILED] %s: %s" % (acct, exc))
    except KeyboardInterrupt:
        print("\ninterrupted")
        failed.append("(interrupted)")
    finally:
        proc.terminate()
        try:
            proc.wait(10)
        except subprocess.TimeoutExpired:
            proc.kill()
        subprocess.run(["systemctl", "start", SERVICE], check=False)
    print("\n%s restarted." % SERVICE)
    if failed:
        die("not authorised: " + ", ".join(failed) + "  (retry; add --reset if the phone password was changed)")
    print("Done. In iOS Mail use the phone password you just typed, for IMAP and SMTP.")


if __name__ == "__main__":
    main()
