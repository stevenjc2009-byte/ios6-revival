#!/usr/bin/env bash
# mailproxy-update -- runs inside the container as root. Started by proxmox/mail/update.sh on the host
# (which pushes the repo's current PIN file), or by hand:   mailproxy-update [PIN-file]
#
# 1. download emailproxy.py at the pinned commit over https; refuse unless its sha256 matches the PIN
# 2. byte-compile it as a syntax check, swap it in (previous copy kept as emailproxy.py.prev)
# 3. restart mailproxy, self-test (every local port answers with the provider's greeting)
# 4. self-test fails -> put the previous copy back, restart, exit 1
# Tokens (/var/lib/mailproxy) and the config (/etc/mailproxy) are never touched. OS packages are
# upgraded by apt (unattended-upgrades does security fixes daily; update.sh also runs apt upgrade).
#
#   mailproxy-update --selftest     only run the self-test
set -Eeuo pipefail
umask 022
APP=/opt/mailproxy/emailproxy.py
CONF=${MAILP_CONF:-/etc/mailproxy/emailproxy.config}
log() { echo "mailproxy-update: $*"; }

selftest() {
    local ports p i ok
    mapfile -t ports < <(sed -n 's/^\[\(IMAP\|SMTP\)-\([0-9]*\)\]$/\1 \2/p' "$CONF")
    [[ ${#ports[@]} -gt 0 ]] || { log "selftest: no servers in $CONF"; return 1; }
    for p in "${ports[@]}"; do
        ok=0
        # shellcheck disable=SC2034
        for i in $(seq 1 20); do
            # a greeting that starts "* OK" (IMAP) or "220" (SMTP) was relayed from the real provider
            if timeout 10 python3 - "${p% *}" "${p#* }" 2>/dev/null <<'PY'
import socket, sys
kind, port = sys.argv[1], int(sys.argv[2])
s = socket.create_connection(("127.0.0.1", port), 8)
s.settimeout(8)
g = s.recv(200)
sys.exit(0 if g.startswith(b"* OK" if kind == "IMAP" else b"220") else 1)
PY
            then ok=1; break; fi
            sleep 1
        done
        [[ $ok -eq 1 ]] || { log "selftest: ${p% *} port ${p#* } gave no provider greeting"; return 1; }
    done
    log "selftest: ok (${#ports[@]} local ports relay the real provider greeting)"
}

if [[ ${1:-} == --selftest ]]; then selftest; exit $?; fi

PIN=${1:-/usr/local/share/mailproxy/PIN}
# shellcheck disable=SC1090
. "$PIN"
: "${MAILP_PROXY_COMMIT:?}" "${MAILP_PROXY_SHA256:?}" "${MAILP_PROXY_VERSION:?}"
[[ $MAILP_PROXY_COMMIT =~ ^[0-9a-f]{40}$ && $MAILP_PROXY_SHA256 =~ ^[0-9a-f]{64}$ ]] || { log "bad PIN file"; exit 1; }
TMP=$(mktemp -d /opt/.mailupdate.XXXXXX)
trap 'rm -rf "$TMP"' EXIT
URL="https://raw.githubusercontent.com/simonrob/email-oauth2-proxy/${MAILP_PROXY_COMMIT}/emailproxy.py"
log "fetching ${URL}"
curl -fsSL --proto '=https' --tlsv1.2 -m 120 -o "$TMP/emailproxy.py" "$URL"
echo "${MAILP_PROXY_SHA256}  $TMP/emailproxy.py" | sha256sum -c - >/dev/null || { log "SHA256 MISMATCH -- refusing to install"; exit 1; }
if [[ -f $APP ]] && cmp -s "$APP" "$TMP/emailproxy.py"; then log "already at ${MAILP_PROXY_VERSION}"; exit 0; fi
python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$TMP/emailproxy.py" || { log "downloaded file does not parse"; exit 1; }
install -d -m 0755 /opt/mailproxy
[[ ! -f $APP ]] || cp -a "$APP" "$APP.prev"
install -m 0644 -o root -g root "$TMP/emailproxy.py" "$APP"
install -m 0644 "$PIN" /usr/local/share/mailproxy/PIN 2>/dev/null || true
log "installed ${MAILP_PROXY_VERSION}; restarting"
systemctl restart mailproxy
if selftest; then log "update complete"; exit 0; fi
log "SELFTEST FAILED -- rolling back"
if [[ -f $APP.prev ]]; then
    install -m 0644 -o root -g root "$APP.prev" "$APP"
    systemctl restart mailproxy
    # shellcheck disable=SC2015
    selftest && log "rolled back; the previous version is serving again" || log "ROLLBACK ALSO FAILED -- journalctl -u mailproxy"
fi
exit 1
