[Unit]
Description=ios6-revival weather and stocks server (WeatherX backend)
Documentation=https://github.com/stevenjc2009-byte/ios6-revival
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=wxserver
Group=wxserver
WorkingDirectory=/opt/wxserver
# Port and bind address live in this file; written by container-setup.sh.
EnvironmentFile=/etc/wxserver/wxserver.env
# HOME and the tool caches point into the private /tmp (PrivateTmp below), so
# ProtectHome stays on and the service has NO persistent write path at all.
# The yfinance cookie cache and the generated-ids file are rebuilt after a restart.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/tmp
Environment=XDG_CACHE_HOME=/tmp/cache
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wxserver/venv/bin/python -m yql_x_server --host ${WXS_BIND} --port ${WXS_PORT} --generated_woeids_path /tmp/generatedWoeids.json
Restart=on-failure
RestartSec=3

# ---- sandbox (every directive below exists in Debian 12's systemd 252) ----
# This process feeds attacker-influenced data (Yahoo and Open-Meteo replies) to
# Python parsers, so it gets no capabilities, no new privileges, a read-only
# filesystem, and no kernel surface.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute=yes is deliberately NOT set: cffi / curl_cffi (used by
# yfinance) map executable memory, and this could not be tested off the target.
#
# AF_INET only: IPv6 is disabled in this container (sysctl) and blocked by the
# host firewall; AF_UNIX is for journald and local IPC. No netlink, no raw.
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A denied syscall returns EPERM (diagnosable, libraries can fall back) rather
# than killing the process with SIGSYS.
SystemCallErrorNumber=EPERM
MemoryMax=768M
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target
